{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "input-pilot",
  "version": "0.1.1",
  "identifier": "org.studio26f.input-pilot",
  "build": {
    "frontendDist": "../dist/spa",
    "devUrl": "http://localhost:9000",
    "beforeDevCommand": "bun spa-dev",
    "beforeBuildCommand": "bun spa-build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Input Pilot",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
